rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function okw(x) { return x is number && x >= 0.5 && x <= 4; }

    // Profil public minimal d'un joueur (lecture : lui seul).
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Unicité des pseudos (clé = pseudo en minuscules).
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Profil de l'IA : privé, taille limitée.
    match /profiles/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 150000
        && request.resource.data.updatedAt == request.time;
    }

    // IA partagée (facultatif) : préférences d'ennemis lisibles par tous, modifiables par leur propriétaire.
    match /ais/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'w', 'style', 'games', 'best', 'updatedAt'])
        && request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(uid)).data.name
        && request.resource.data.w.keys().hasOnly(['grunt', 'runner', 'brute', 'saboteur'])
        && okw(request.resource.data.w.grunt) && okw(request.resource.data.w.runner)
        && okw(request.resource.data.w.brute) && okw(request.resource.data.w.saboteur)
        && request.resource.data.style is string && request.resource.data.style.size() <= 60
        && request.resource.data.games is int && request.resource.data.best is int
        && request.resource.data.best >= 0 && request.resource.data.best <= 200
        && request.resource.data.updatedAt == request.time;
    }

    // Classement : un meilleur résultat par joueur et par carte.
    // score = vague × 1 000 000 + vies restantes × 10 000 + (9 999 − durée en secondes) : il départage les égalités.
    match /maps/{map}/scores/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && map in ['vallee', 'serpentin', 'spirale', 'noeud', 'lac', 'defile', 'labyrinthe']
        && request.resource.data.keys().hasOnly(['name', 'wave', 'lives', 'time', 'score', 'updatedAt'])
        && request.resource.data.wave is int && request.resource.data.wave >= 1 && request.resource.data.wave <= 200
        && request.resource.data.lives is int && request.resource.data.lives >= 0 && request.resource.data.lives <= 20
        && request.resource.data.time is int && request.resource.data.time >= request.resource.data.wave * 8 && request.resource.data.time <= 9999
        && request.resource.data.score == request.resource.data.wave * 1000000 + request.resource.data.lives * 10000 + (9999 - request.resource.data.time)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(uid)).data.name
        && request.resource.data.updatedAt == request.time
        && (
          // soit un simple changement de pseudo,
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          // soit un meilleur résultat, au moins 60 s après le précédent.
          || (request.resource.data.keys().hasOnly(['name', 'wave', 'lives', 'time', 'score', 'updatedAt'])
              && request.resource.data.wave is int && request.resource.data.wave >= 1 && request.resource.data.wave <= 200
              && request.resource.data.lives is int && request.resource.data.lives >= 0 && request.resource.data.lives <= 20
              && request.resource.data.time is int && request.resource.data.time >= request.resource.data.wave * 8 && request.resource.data.time <= 9999
              && request.resource.data.score == request.resource.data.wave * 1000000 + request.resource.data.lives * 10000 + (9999 - request.resource.data.time)
              && (!('score' in resource.data) || request.resource.data.score > resource.data.score)
              && request.time > resource.data.updatedAt + duration.value(60, 's'))
        );
    }
  }
}
